# Copy this file to .env on a development machine. Docker Compose will then
# automatically include the local Traefik configuration overlay.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
COMPOSE_PROJECT_NAME=traefik

# Loopback-only local ports. EC2 has no .env file and therefore keeps the
# production defaults 80, 443 and 127.0.0.1:8080.
TRAEFIK_HTTP_BIND=127.0.0.1
TRAEFIK_HTTP_PORT=8085
TRAEFIK_HTTPS_BIND=127.0.0.1
TRAEFIK_HTTPS_PORT=8445
TRAEFIK_DASHBOARD_BIND=127.0.0.1
TRAEFIK_DASHBOARD_PORT=8086
